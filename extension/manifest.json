{
  "manifest_version": 3,
  "name": "Remover",
  "description": "Connect remover to X. Manage inactive followers from your terminal, with progress saved on your computer.",
  "version": "0.3.2",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "cookies",
    "scripting",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://abs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Remover \u00b7 Connect Chrome",
    "default_icon": {
      "16": "icons/r-16.png",
      "32": "icons/r-32.png",
      "48": "icons/r-48.png",
      "128": "icons/r-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://x.com https://abs.twimg.com ws://127.0.0.1:*"
  },
  "homepage_url": "https://github.com/altonwells/x-bot-follower-remover",
  "icons": {
    "16": "icons/r-16.png",
    "32": "icons/r-32.png",
    "48": "icons/r-48.png",
    "128": "icons/r-128.png"
  }
}
